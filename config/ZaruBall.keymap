//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/naginata.dtsi>

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

#include <behaviors/mejiro.dtsi>
#include <dt-bindings/zmk/mejiro.h>

#define BASE     0
#define NAGINATA 1
#define MOUSE    2
#define LOWER    3
#define RAISE    4
#define ADJUST   5
#define MOD      6
#define SCROLL   3
#define MUHEN   7
#define HENKA   8




// スクロール量の設定
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                        &zip_temp_layer MOUSE 500>;
    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
                            >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定
        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&BL_mod LCTRL>, <&mo RAISE>, <&mo MOUSE>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTL LBKT>, <&kp KP_NUM>, <&kp RBKT>;
        };



        // Customed Hold-Tap for SandS
        // 他キーとの同時押しのみHold(Shift), 500m以上長押しすると、Tap(Space)のリピート
        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>; // tap-unless-interruptedのため意味は無いが、設定しないとエラーはく
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        ht_BASE: ht_BASE {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&BL_mod>, <&kp>;

            display-name = "ht-BL_mod";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer)
        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        // Support swapping into Scroll layer when AML is activated

        to_scroll_layer: to_scroll_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to SCROLL>,
                <&macro_press>,
                <&mo SCROLL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo SCROLL>;
        };

        BL_mod: BL_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo MOD &macro_param_1to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&mo MOD>;
        };

        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG1 &to NAGINATA>;
            //bindings = <&macro_tap &kp CAPS &to NAGINATA>;
        };
    
        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG2 &to BASE>;
            //bindings = <&macro_tap &kp CAPS &to BASE>;
        };

        mg_on: mg_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG1 &to MOD>;
            //bindings = <&macro_tap &kp CAPS &to MOD>;
        };

    };

    combos {
        compatible = "zmk,combos";
        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <45 47>; // 45 65 6 7
            bindings = <&ng_on>;
            layers = <0 1 6>;
        };

        combo_ng_off {
            timeout-ms = <300>;
            key-positions = <34 36>; // 34 36 6 8
            bindings = <&ng_off>;
            layers = <0 1 6>;
        };

        combo_mg_on {
            timeout-ms = <300>;
            key-positions = <52 54>; // 45 65 6 7
            bindings = <&mg_on>;
            layers = <0 1 6>;
        };

};
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC         &kp N1      &kp N2  &kp N3    &kp N4     &kp N5                              &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                 &kp N6        &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB         &kp Q       &kp W   &kp E     &kp R      &kp T                               &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY               &kp Y         &kp U   &kp I      &kp O    &kp P     &kp EQUAL
&mt LCTRL CAPS  &kp A       &kp S   &kp D     &kp F      &kp G               &td2            &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS                  &kp LBKT      &kp H   &kp J      &kp K    &kp L     &kp SEMI  &kp SQT
&mt LSHIFT PSCRN &kp Z &kp X &kp C &kp V &kp B               &mt KP_NUM INT1 &kp KP_ENTER &kp KP_N0 &kp KP_DOT &kp KP_PLUS        &kp RBKT &kp N &kp M &kp COMMA &kp DOT &kp FSLH &lt SCROLL BSLH
&kp LCTRL        &kp C_MUTE  &kp LWIN  &lt 7 BSPC &kp SPACE  &lt 3 PSCRN                                                               &lt 4 RET   &SandS LSHIFT SPACE                                           &kp LCTRL
            >;
        };

        naginata_layer {
            display-name = "Naginata";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp CAPS      &mj lX  &mj lT      &mj lY        &mj lI       &mj lU                       &trans &trans &trans &trans               &mj rU  &mj rI      &mj rY        &mj rT       &mj rX &mj rS
&trans        &mj lS   &mj lK       &mj lN         &mj lA        &mj lU                        &trans &trans &trans &trans              &mj rU  &mj rA      &mj rN        &mj rK       &mj rS &mj rX
&mt LCTRL ESC &mj lX   &mj rX       &kp KP_NUM          &mj ln        &mj ln      &mj ln       &trans &trans &trans &trans  &mj rn &mj rn   &mj rn   &mj rn      &ng L    &mj rX   &mj rS 
&trans        &kp Z   &kp X       &mt KP_NUM INT1         &mj lk        &mj lt      &mj lk  &trans &trans &trans &trans  &trans        &mj rk   &mj rt   &mj rk  &kp DOT  &kp SLASH  &trans
&BL_mod LCTRL &trans      &BL_mod LWIN  &trans      &mj lt   &trans                                        &lt RAISE RET   &mj rt                                           &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC     &to_layer_0 N1  &to_layer_0 N2      &to_layer_0 N3  &to_layer_0 N4      &to_layer_0 N5                  &trans &trans &trans &trans                    &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8  &to_layer_0 N9      &to_layer_0 N0            &to_layer_0 INT_YEN
&to_layer_0 TAB     &to_layer_0 SQT  &to_layer_0 COMMA  &to_layer_0 DOT   &to_layer_0 P       &to_layer_0 J                 &trans &trans &trans &trans                    &to_layer_0 F   &to_layer_0 G   &to_layer_0 C   &to_layer_0 R       &to_layer_0 L             &to_layer_0 SLASH
&kp LCTRL           &to_layer_0 A    &mkp RCLK         &mkp MCLK       &mkp_exit_AML LCLK  &msc SCRL_UP    &msc SCRL_LEFT   &trans &trans &trans &trans   &msc SCRL_LEFT   &msc SCRL_UP    &mkp LCLK       &mkp MCLK       &mkp RCLK           &to_layer_0 S             &to_layer_0 MINUS
&kp LSHIFT          &to_layer_0 SEMI &to_layer_0 Q     &mkp MB4        &mkp MB5            &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans &trans &trans &trans   &msc SCRL_RIGHT  &msc SCRL_DOWN  &mkp MB5        &mkp MB4        &to_layer_0 V       &to_layer_0 Z         &lt SCROLL BACKSLASH
&td0              &trans          &kp LWIN       &lt MUHEN BSPC  &SandS LSHFT SPACE      &trans                                               &lt RAISE RET    &lt HENKA RET                                                               &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp ESC       &kp F1   &kp F2     &kp F3    &kp F4     &kp F5                &trans &trans &trans &trans                &kp LA(F2)    &kp N0  &kp N0 &kp N0 &kp KP_SLASH    &kp KP_NUMLOCK
&kp TAB       &kp F6   &kp F7     &kp F8    &kp F9     &kp F10               &trans &trans &trans &trans                &kp LS(MINUS) &kp N7  &kp N8 &kp N9 &kp KP_MULTIPLY &kp LS(MINUS)
&kp LCTRL     &kp F11  &kp F12    &kp UP    &kp LC(F8) &kp HOME  &kp PG_UP   &trans &trans &trans &trans   &kp C_VOL_UP &kp N0        &kp N4  &kp N5 &kp N6 &kp KP_MINUS    &kp LS(MINUS)
&kp LSHIFT    &none    &kp LEFT   &kp DOWN  &kp RIGHT  &kp END   &kp PG_DN   &trans &trans &trans &trans   &kp C_VOL_DN &kp KP_DOT    &kp N1  &kp N2 &kp N3  &kp KP_PLUS    &none
&trans           &kp RSHFT  &BL_mod LWIN    &trans     &trans    &trans                                    &lt RAISE RET    &mt LSHFT RET                                             &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LA(F2) LA(F1)>;
            bindings = <
&kp ESC     &kp LC(F1)   &kp LC(F2)   &kp LC(F3)   &kp LC(F4)     &kp LC(F5)           &trans &trans &trans &trans                    &kp LC(F6)       &kp LC(F7)       &kp LC(F8)       &kp LC(F9)        &kp LC(F10)   &kp LC(F11)
&kp TAB     &kp LC(HOME) &kp PG_UP    &kp LC(UP)   &kp PG_DN      &kp LC(END)          &trans &trans &trans &trans                    &kp LC(LS(HOME)) &kp LC(PG_UP)    &kp LC(LS(UP))   &kp LC(PG_DN)     &kp LC(SPACE) &kp LC(LS(DEL))
&kp LCTRL   &kp HOME     &kp LC(LEFT) &kp LC(DOWN) &kp LC(RIGHT)  &kp END &kp KP_NUM   &trans &trans &trans &trans  &kp LC(F8)        &kp SPACE        &kp LC(LS(LEFT)) &kp LC(LS(DOWN)) &kp LC(LS(RIGHT)) &kp LS(SPACE) &kp LC(END) 
&kp LSHFT   &kp LC(F8)   &kp F2       &kp F3       &kp F4         &kp F5   &kp LC(F12) &trans &trans &trans &trans  &kp LG(LS(PSCRN)) &kp F6           &kp F7           &kp F8           &kp F9            &kp F10       &kp F11
&trans        &kp C_MUTE  &trans  &trans  &mt LSHFT SPACE                               &trans     &trans    &trans                              &td1
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&kp ESC    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4           &trans &trans &trans &trans            &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&kp TAB    &none         &none         &none         &none         &none                  &trans &trans &trans &trans            &bt BT_CLR      &none  &none  &none  &none  &none
&kp LCTRL  &kp     N1  &kp N2      &kp N3          &kp N4          &kp N5        &kp N0   &trans &trans &trans &trans   &ind_bat &out OUT_TOG    &kp N6         &kp N7         &kp N8         &kp N9      &kp N0 
&kp LSHIFT &kp LS(N1)  &kp LS(N2)  &kp LS(N3)      &kp LS(N4)      &kp LS(N5)    &none    &trans &trans &trans &trans   &ind_con &studio_unlock  &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)  &none
&trans                &kp C_MUTE    &trans        &trans        &trans        &trans                                 &trans   &trans                                     &trans
            >;
        };

        mod_layer {
            display-name = "Mod";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&mt LSHFT ESC   &kp Q     &kp W  &kp E    &kp R     &kp T                              &kp KP_N7     &kp KP_N8  &kp KP_N9   &lt ADJUST KP_DIVIDE                 &kp Y  &kp U  &kp I     &kp O   &kp P    &kp MINUS
&kp LBKT        &kp A       &kp S   &kp D     &kp F      &kp G                               &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY               &kp H         &kp J   &kp K      &kp L    &kp SEMI     &kp SQT
&mt LCTRL CAPS  &kp A       &kp S   &kp C     &kp C      &kp C        &kp C            &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp COMMA    &kp COMMA     &kp COMMA &kp COMMA  &kp DOT  &kp LBKT  &lt SCROLL BACKSLASH
&mt LSHFT PSCRN &kp Z       &kp X   &kp C     &kp B &kp V  &kp B                          &mt KP_NUM INT1  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp N   &kp M     &kp N &kp COMMA  &kp DOT  &kp FSLH  &lt SCROLL BACKSLASH
&mt LCTRL CAPS  &kp C_MUTE  &BL_mod LWIN  &kp B &kp SPACE  &kp B                                                                                      &kp N   &kp M                                     &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        MUHEN_layer {
            display-name = "MUHEN";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC     &kp LC(EXCL) &kp LC(AT) &kp LC(HASH)    &kp LC(DLLR)       &kp LC(PRCNT)            &trans &trans &trans &trans             &kp LC(CARET)  &kp LC(AMPS)   &kp LC(ASTRK) &kp LC(LPAR) &kp LC(RPAR) &kp F12
&kp TAB     &kp HOME       &kp F17        &kp UP        &kp LS(RIGHT)   &kp END                 &trans &trans &trans &trans             &kp LALT       &kp LC(U)        &kp TAB        &kp F7         &kp LC(P)       &kp PG_DN
&kp LCTRL   &kp LC(BSPC)   &kp LEFT       &kp DOWN      &kp RIGHT       &kp DEL &kp KP_NUM      &trans &trans &trans &trans  &kp LC(F8) &kp BSPC       &kp LG(SLASH)    &kp LC(Z)      &kp LA(TAB)    &kp LC(LA(TAB))   &kp LC(F)
&kp LSHFT   &kp LC(D)      &kp LC(X)      &kp  LC(C)    &kp LC(V)       &kp F16 &kp F12         &trans &trans &trans &trans  &kp RBKT  &kp LC(LA(TAB)) &kp LC(LS(TAB))  &kp LC(Y)      &kp LC(TAB)    &kp LG(TAB)     &kp LG(D)
&trans        &kp C_MUTE  &trans  &trans  &mt LSHFT SPACE                               &trans     &trans    &trans                              &kp LC(W)
            >;
        };

        HENKA_layer {
            display-name = "HENKA";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC    &none  &none  &none      &none      &none                             &trans &trans &trans &trans              &none      &none         &none      &none         &none   &none
&kp TAB    &kp LS(N1)  &kp LS(N2)  &kp LS(N3)      &kp LS(N4)      &kp LS(N5)    &trans &trans &trans &trans              &kp LS(N6) &kp LS(N7)    &kp LS(N8) &kp LS(N9)    &kp LS(N0)  &none
&kp LCTRL  &none  &none  &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT    &trans &trans &trans &trans   &kp PG_UP  &kp HOME   &kp LC(PG_UP) &kp UP     &kp LC(PG_DN) &none   &none
&kp LSHIFT &none  &none  &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT   &trans &trans &trans &trans   &kp PG_DN  &kp END    &kp LEFT      &kp DOWN   &kp RIGHT     &none   &none
&trans         &none  &trans     &trans     &trans          &trans                                          &trans     &trans                                         &trans
            >;
        };




    };
};
